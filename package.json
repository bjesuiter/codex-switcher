{
  "name": "@bjesuiter/codex-switcher",
  "version": "1.8.6",
  "type": "module",
  "description": "CLI tool to switch between multiple OpenAI accounts for OpenCode",
  "bin": {
    "cdx": "cdx.ts"
  },
  "scripts": {
    "build": "tsdown && bun run scripts/build-dist-pkg.ts",
    "prerelease": "bun run build",
    "release": "npm publish --access public ./dist",
    "wait-npm-latest": "bun run scripts/wait-for-npm-latest.ts",
    "test-npm-install": "bun run playground/test-npm-install.ts"
  },
  "keywords": [
    "openai",
    "opencode",
    "codex",
    "account-switcher",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjesuiter/codex-switcher.git"
  },
  "license": "MIT",
  "author": "bjesuiter",
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "tsdown": "^0.21.2"
  },
  "dependencies": {
    "@bjesuiter/cross-keychain": "1.1.0-jb.0",
    "@bomb.sh/tab": "^0.0.14",
    "@clack/prompts": "^1.1.0",
    "@openauthjs/openauth": "^0.4.3",
    "age-encryption": "^0.3.0",
    "commander": "^14.0.3"
  }
}
